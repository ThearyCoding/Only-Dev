# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/e_learning_db

# Redis Configuration (Caching & Token Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expirations
JWT_SECRET=super_secret_jwt_access_key_2026_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 Storage (S3-Compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=elearning-media
R2_PUBLIC_URL=https://media.yourdomain.com
